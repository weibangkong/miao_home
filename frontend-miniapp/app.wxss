/**
 * 喵之家 — 全局样式
 */

page {
  --color-primary: #667eea;
  --color-primary-dark: #5a6fd6;
  --color-success: #52c41a;
  --color-warning: #faad14;
  --color-danger: #ff4d4f;
  --color-info: #1677ff;
  --color-text: #333333;
  --color-text-secondary: #999999;
  --color-text-light: #bfbfbf;
  --color-bg: #f5f5f5;
  --color-bg-card: #ffffff;
  --color-border: #f0f0f0;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --shadow-card: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);

  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-text);
  background-color: var(--color-bg);
  box-sizing: border-box;
}

/* ======== 通用容器 ======== */

.page-container {
  min-height: 100vh;
  padding-bottom: 20rpx;
}

.safe-bottom {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

/* ======== 通用卡片 ======== */

.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin: 16rpx 24rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-card);
}

/* ======== 通用按钮 ======== */

.btn-primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-outline {
  background: #fff;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 18rpx 36rpx;
}

/* ======== 状态气泡 ======== */

.bubble {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.bubble-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.bubble-success {
  background: #f6ffed;
  color: #389e0d;
}
.bubble-success .bubble-dot {
  background: #52c41a;
}

.bubble-warning {
  background: #fffbe6;
  color: #d48806;
}
.bubble-warning .bubble-dot {
  background: #faad14;
}

.bubble-danger {
  background: #fff2f0;
  color: #cf1322;
}
.bubble-danger .bubble-dot {
  background: #ff4d4f;
}

.bubble-info {
  background: #e6f4ff;
  color: #0958d9;
}
.bubble-info .bubble-dot {
  background: #1677ff;
}

.bubble-neutral {
  background: #f5f5f5;
  color: #8c8c8c;
}

/* ======== 性别徽章 ======== */

.gender-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 800;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

.gender-male {
  background: linear-gradient(135deg, #1677ff, #4096ff);
}

.gender-female {
  background: linear-gradient(135deg, #eb2f96, #ff85c0);
}

.gender-unknown {
  background: #bfbfbf;
}

/* ======== 统计数据 ======== */

.stat-row {
  display: flex;
  margin: 16rpx 24rpx;
  gap: 16rpx;
}

.stat-item {
  flex: 1;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx;
  text-align: center;
  box-shadow: var(--shadow-card);
}

.stat-value {
  font-size: 48rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #667eea, #764ba2);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

/* ======== 空状态 ======== */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: var(--color-text-light);
}

.empty-state .empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-state .empty-text {
  font-size: 28rpx;
}

/* ======== 加载 ======== */

.loading-center {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 200rpx 0;
}

/* ======== 页面标题 ======== */

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 12rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}

/* ======== 搜索栏 ======== */

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx 16rpx;
}

.search-input {
  flex: 1;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* ======== 列表项 ======== */

.list-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.list-item:last-child {
  border-bottom: none;
}

/* ======== 响应式辅助 ======== */

.flex-row {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-24 { gap: 24rpx; }

.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-12 { margin-bottom: 12rpx; }
.mb-16 { margin-bottom: 16rpx; }
