/* 小区切换栏 */
.community-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 24rpx 4rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.community-bar:active {
  background: #f5f5f5;
}

.community-bar-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.community-bar-icon {
  font-size: 28rpx;
}

.community-bar-label {
  font-size: 24rpx;
  color: #999;
}

.community-bar-right {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.community-bar-name {
  font-size: 26rpx;
  color: #667eea;
  font-weight: 600;
}

.community-bar-arrow {
  font-size: 30rpx;
  color: #ccc;
}

/* 区块标题 */
.cat-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx 8rpx;
}

.cat-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
}

.cat-section-count {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

/* 横向分割线 */
.cat-divider-wrap {
  margin-top: 8rpx;
}

.cat-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 8rpx;
}

.cat-divider-line {
  flex: 1;
  height: 1rpx;
  background: #e0e0e0;
}

.cat-divider-text {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
}

/* 我的认养（紧凑横向滚动） */
.my-cats-scroll {
  white-space: nowrap;
  padding: 0 16rpx;
}

.my-cats-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 8rpx;
}

.my-cat-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 120rpx;
}

.my-cat-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, #f5f7ff, #e8ecff);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.my-cat-avatar image {
  width: 100%;
  height: 100%;
}

.my-cat-avatar text {
  font-size: 44rpx;
}

.my-cat-name {
  font-size: 22rpx;
  color: #333;
  font-weight: 500;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

/* 猫咪网格 */
.cat-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}

.cat-grid-item {
  width: 50%;
  padding: 8rpx;
  box-sizing: border-box;
}

/* 楼栋筛选条 */
.building-filter {
  white-space: nowrap;
  padding: 0 24rpx 16rpx;
}

.building-chips {
  display: inline-flex;
  gap: 12rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  background: #fff;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.chip-active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}
