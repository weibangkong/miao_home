/* 副标题 */
.range-subtitle {
  font-size: 24rpx;
  color: #bfbfbf;
  margin-bottom: 24rpx;
}

/* 楼栋列表（左右分布） */
.building-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.building-row {
  display: flex;
  align-items: center;
  background: #fafbfc;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
  transition: all 0.2s;
  border: 2rpx solid transparent;
  gap: 16rpx;
}

.building-row.has-pending {
  border-color: #ffd591;
  background: #fffbe6;
}

.building-row:active {
  transform: scale(0.98);
  background: #f0f0f0;
}

/* 左侧：图标 + 信息 */
.building-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.building-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.building-info {
  flex: 1;
  min-width: 0;
}

.building-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 10rpx;
}

/* 进度条：橙底=待认养，绿条=已认养 */
.building-bar {
  height: 10rpx;
  background: #ffe7ba;
  border-radius: 5rpx;
  overflow: hidden;
}

.building-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #52c41a, #73d13d);
  border-radius: 5rpx;
  transition: width 0.5s ease;
}

/* 右侧：数量 */
.building-right {
  flex-shrink: 0;
  text-align: right;
  min-width: 140rpx;
}

.building-num {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 4rpx;
}

.building-num-total {
  font-size: 40rpx;
  font-weight: 800;
  color: #333;
  line-height: 1;
}

.building-num-unit {
  font-size: 22rpx;
  color: #999;
}

.building-num-detail {
  display: flex;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.building-stats-adopted {
  color: #52c41a;
  font-weight: 500;
}

.building-stats-pending {
  color: #faad14;
  font-weight: 500;
}

/* 箭头 */
.building-arrow {
  font-size: 36rpx;
  color: #ccc;
  flex-shrink: 0;
  font-weight: 300;
}

/* 一览区 */
.range-building-section {
  margin-bottom: 24rpx;
}

.range-building-section:last-child {
  margin-bottom: 0;
}

.range-building-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.range-building-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.range-building-count {
  font-size: 22rpx;
  color: #999;
}

.range-cat-scroll {
  white-space: nowrap;
}

.range-cat-list {
  display: inline-flex;
  gap: 16rpx;
}

.range-cat-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 140rpx;
}

.range-cat-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, #f5f7ff, #e8ecff);
  display: flex;
  align-items: center;
  justify-content: center;
}

.range-cat-img {
  width: 100%;
  height: 100%;
}

.range-cat-emoji {
  font-size: 48rpx;
}

.range-cat-name {
  font-size: 22rpx;
  color: #333;
  font-weight: 500;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  height: 75vh;
  background: #f5f5f5;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx 16rpx;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.modal-close {
  font-size: 36rpx;
  color: #bfbfbf;
  padding: 0 10rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx;
}

.modal-body .cat-grid {
  display: flex;
  flex-wrap: wrap;
}

.modal-body .cat-grid-item {
  width: 50%;
  padding: 8rpx;
  box-sizing: border-box;
}
