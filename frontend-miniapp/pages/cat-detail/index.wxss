/* 鍑烘病鍦扮偣 */
.location-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.location-item:last-child {
  border-bottom: none;
}

.location-tenant {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.location-buildings-text {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 500;
  background: #f0f2ff;
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
}

/* 澶村儚鍖?*/
.detail-avatar-wrap {
  position: relative;
  width: 100%;
  height: 520rpx;
  overflow: hidden;
}

.detail-avatar {
  width: 100%;
  height: 100%;
}

.detail-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 140rpx;
  background: linear-gradient(135deg, #f5f7ff, #e8ecff);
}

.avatar-tags {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

/* 鍩烘湰淇℃伅 */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  color: #333;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 50%;
  padding: 12rpx 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  min-width: 100rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.info-desc {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 鍋ュ悍璁板綍 */
.health-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.health-item:last-child {
  border-bottom: none;
}

.health-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.health-date {
  font-size: 22rpx;
  color: #bfbfbf;
}

/* 濯掍綋 */
.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.media-item {
  position: relative;
  width: calc(33.33% - 8rpx);
  height: 220rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f0f0f0;
}

.media-img {
  width: 100%;
  height: 100%;
}

.media-video-wrap {
  position: relative;
  width: 100%;
  height: 100%;
}

.media-play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 40rpx;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.media-tag {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
}

.media-avatar-tag {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
}

/* 璁ゅ吇璁板綍 */
.adopter-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.adopter-item:last-child {
  border-bottom: none;
}

.adopter-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.adopter-detail {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  font-size: 24rpx;
  color: #666;
}

/* 搴曢儴鎸夐挳 */
.bottom-bar {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.adopt-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}

/* 点赞按钮 */
.like-btn {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.9);
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

/* 评论输入区 */
.comment-input-area {
  margin-bottom: 20rpx;
}

.reply-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #e6f4ff;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #1677ff;
  margin-bottom: 12rpx;
}

.cancel-reply {
  color: #666;
  font-size: 24rpx;
}

.comment-textarea {
  width: 100%;
  min-height: 120rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid #eee;
}

.comment-submit-btn {
  margin-top: 12rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
  display: inline-block;
}

/* 排序栏 */
.comment-sort-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.comment-count {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}

.sort-tabs {
  display: flex;
  gap: 16rpx;
}

.sort-tab {
  font-size: 24rpx;
  color: #999;
}

.sort-tab.active {
  color: #1677ff;
  font-weight: 600;
}

/* 评论列表 */
.comment-item {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1677ff, #764ba2);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.comment-avatar.sm {
  width: 48rpx;
  height: 48rpx;
  font-size: 24rpx;
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.comment-nickname {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #bfbfbf;
}

.comment-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

.comment-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
}

.action-btn {
  font-size: 24rpx;
  color: #999;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.action-btn.danger {
  color: #ff4d4f;
}

/* 子回复 */
.replies-wrap {
  margin-top: 16rpx;
  padding-left: 24rpx;
  border-left: 3rpx solid #f0f0f0;
  margin-left: -80rpx;
  padding-left: 24rpx;
}

.reply-item {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.reply-item:last-child {
  border-bottom: none;
}

.loading-small, .empty-small {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999;
}
