/* 未读徽章 */
.unread-badge {
  background: linear-gradient(135deg, #ff4d4f, #ff7875);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 18rpx;
  padding: 0 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3);
}

.mark-all-read {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 500;
}

/* 通知列表 */
.notif-list {
  padding: 0 24rpx;
}

.notif-item {
  display: flex;
  gap: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.notif-unread {
  background: linear-gradient(135deg, #f8f9ff, #edf1ff);
  border: 2rpx solid #d6e4ff;
}

.notif-left {
  flex-shrink: 0;
}

.notif-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.notif-icon-unread {
  background: linear-gradient(135deg, #667eea, #764ba2);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.notif-body {
  flex: 1;
  min-width: 0;
}

.notif-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.notif-content {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
  line-height: 1.5;
}

.notif-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.notif-time {
  font-size: 22rpx;
  color: #bfbfbf;
}

.notif-mark-read {
  font-size: 22rpx;
  color: #667eea;
  font-weight: 500;
}
