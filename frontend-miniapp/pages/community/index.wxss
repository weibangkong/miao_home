/* 头部 */
.community-header {
  text-align: center;
  padding: 48rpx 24rpx 32rpx;
}

.community-header-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.community-header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.community-header-desc {
  font-size: 24rpx;
  color: #999;
}

/* 列表 */
.community-list {
  padding: 0 24rpx;
}

.community-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
  border: 2rpx solid transparent;
}

.community-item:active {
  transform: scale(0.98);
  background: #f5f5f5;
}

.community-active {
  border-color: #667eea;
  background: linear-gradient(135deg, #f8f9ff, #edf1ff);
}

.community-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.community-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f0f2ff, #e8ecff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.community-info {
  flex: 1;
  min-width: 0;
}

.community-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 4rpx;
}

.community-code {
  font-size: 22rpx;
  color: #999;
}

.community-buildings {
  font-size: 22rpx;
  color: #999;
  margin-top: 2rpx;
}

.community-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.community-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.community-arrow {
  font-size: 36rpx;
  color: #ccc;
}
