root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
charset = utf-8

[*.properties]
charset = utf-8

[*.{xml,yaml,yml}]
charset = utf-8

[*.{ts,tsx,js,jsx}]
charset = utf-8

[*.{json,jsonc}]
charset = utf-8

[*.{css,scss,less,html}]
charset = utf-8

[*.md]
charset = utf-8
trim_trailing_whitespace = false
